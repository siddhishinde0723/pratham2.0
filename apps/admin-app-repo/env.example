# Environment variables for admin-app-repo
# Copy this file to .env.local and update the values as needed

# Workspace MFE base URL (where the workspace microfrontend is running)
NEXT_PUBLIC_WORKSPACE_BASE_URL=http://localhost:3001

# Telemetry service URL
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:3001

# Cloud storage URL (S3 bucket)
CLOUD_STORAGE_URL=https://saas-prod.s3.ap-south-1.amazonaws.com

# Alternative cloud storage URL (if using different bucket)
NEXT_PUBLIC_CLOUD_STORAGE_URL=https://saas-prod.s3.ap-south-1.amazonaws.com

# Base URL for the application
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Interface API URL for group operations
NEXT_PUBLIC_INTERFACE_URL=https://shiksha-dev-interface.tekdinext.com

# Authentication API token (if needed)
AUTH_API_TOKEN=your-auth-token-here

# AWS configuration (if using direct S3 access)
AWS_BUCKET_NAME=saas-prod
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
